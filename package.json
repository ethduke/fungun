{
  "name": "fungun",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "setup": "npm --prefix apps/web ci && git config --local core.hooksPath .githooks",
    "dev": "npm --prefix apps/web run dev -- --hostname 127.0.0.1 --port 3000",
    "build": "npm --prefix apps/web run build",
    "lint": "npm --prefix apps/web run lint",
    "typecheck": "npm --prefix apps/web run typecheck",
    "test": "node --experimental-strip-types --test scripts/check-repository.test.mjs apps/web/lib/launch-model.test.ts apps/web/lib/preview-web3.test.ts apps/web/lib/fees-model.test.ts",
    "check:staged": "node scripts/check-repository.mjs",
    "check:tracked": "node scripts/check-repository.mjs --tracked",
    "check:history": "node scripts/check-repository.mjs --history"
  }
}
