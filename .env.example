# Required for paid Grok image generation. Keep provider credentials server-only.
OPENROUTER_KEY=
IMAGE_GENERATION=true
IMAGE_PAYMENT_RECIPIENT=
# Canonical USDG contract from the official Robinhood Chain contracts registry.
IMAGE_USDG_ADDRESS=<canonical-usdg-address>
# Required ceiling only (not a fixed price); 100000 base units = 0.10 USDG.
IMAGE_MAX_PRICE_USDG_BASE_UNITS=100000
X402_FACILITATOR_URL=https://farmgun-facilitator.fly.dev
# Required server-only credential for the private facilitator.
X402_FACILITATOR_BEARER_TOKEN=
# Required only by the dedicated facilitator process; never expose it to the asset or web app.
X402_FACILITATOR_PRIVATE_KEY=
# Required read-only RPC for payment reconciliation.
ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com
# Other application runtimes. Leave this template blank; use local .env/Fly secrets.
O1_API_KEY=
RPC_HTTP_URL=
READ_UPSTREAMS=
APP_ORIGIN=
READ_SERVICE_ORIGIN=
READ_SERVICE_PORT=
BUDGET_DB_PATH=
READS_MACHINE_ID=
ROBINHOOD_RPC_URL=
# Live Long wallet launch is disabled unless this is exactly true. All four settings are API-only.
LONG_WALLET_LAUNCH=false
LONG_LAUNCH_PROFILE_JSON=
LONG_LAUNCH_GUARDS_JSON=
LAUNCH_ASSET_SERVICE_ORIGIN=
LONG_TICKER_REGISTRY_ADDRESS=
LONG_TICKER_REGISTRY_CODE_HASH=
LONG_RWA_ALLOWLIST=
READ_FEES=
WALLET_CLAIMS=
BASE_RPC_URL=
# Base O1 launches require a reviewed Base profile and FEE_CONTRACTS_JSON.baseOracle.
O1_BASE_WALLET_LAUNCH=false
O1_BASE_LAUNCH_PROFILE_JSON=
PONS_WALLET_LAUNCH=false
PONS_LAUNCH_PROFILE_JSON=
O1_WALLET_LAUNCH=false
O1_LAUNCH_PROFILE_JSON=
O1_LAUNCH_TOKENS_JSON=
RPC_BATCH_REQUESTS=
FEE_CONTRACTS_JSON=
ASSET_STORE_ROOT=
ASSET_PUBLIC_ORIGIN=
ASSET_DECODER_ORIGIN=
ASSET_UPLOADS=
ASSETS_MACHINE_ID=
ASSET_STORAGE=
PINATA_GATEWAY=
PINATA_JWT=
ASSET_SERVICE_ORIGIN=
# Offline snapshot tool only; never forwarded to the asset HTTP process.
ASSET_BACKUP_ROOT=
ASSET_BACKUP_SHA256=
ASSET_RESTORE_ROOT=

# FOMO app-feed collector (read service only; one socket for all configured users).
# Rolling 24-hour connection attempt limit (1–1440); default 48.
FOMO_MAX_CONNECTIONS_24H=48
FOMO_ENABLED=0
FOMO_API_KEY=
# Optional absolute path to a canonical-handle => display-label JSON mapping.
FOMO_USERS_PATH=

# Reviewed Stonks Exchange deployment on Base; operational profile stays out of Git.
STONKS_BASE_WALLET_LAUNCH=false
STONKS_BASE_PROFILE_JSON=
